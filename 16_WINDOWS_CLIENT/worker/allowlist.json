{
  "schema_version": 1,
  "execution_owner": "neewa-windows-worker",
  "git_writer": "Cursor",
  "coordinator": "NEEWA on neewa-core-01",
  "desktop_driver": "local cua-driver on neewa-edge-01",
  "transport": "outbound SSH poll to ubuntu@neewa-core-01",
