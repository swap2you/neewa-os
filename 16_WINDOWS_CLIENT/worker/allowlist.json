{
  "schema_version": 1,
  "execution_owner": "neewa-windows-worker",
  "git_writer": "Cursor",
  "coordinator": "NEEWA on neewa-core-01",
  "desktop_driver": "local cua-driver on neewa-edge-01",
  "transport": "outbound SSH poll to ubuntu@neewa-core-01",
  "public_listener": false,
  "tailscale_funnel": false,
  "unrestricted_shell": false,
  "approved_roots": [
    "%USERPROFILE%\\NEEWA-Personal",
    "C:\\Development\\Workspace"
  ],
  "approved_root_modes": {
    "%USERPROFILE%\\NEEWA-Personal": "read_write_jobs",
    "C:\\Development\\Workspace": "personal_a1_except_denied"
  },
  "denied_roots": [
    "%USERPROFILE%\\.ssh",
    "%USERPROFILE%\\.aws",
    "%USERPROFILE%\\.gnupg",
    "C:\\Users",
    "employer repositories and documents",
    "C:\\Development\\Workspace\\api-fintech-automation-platform",
    "C:\\Development\\Workspace\\perf-fintech-testing-platform",
    "C:\\Development\\Workspace\\ui-fintech-automation-platform",
    "C:\\Development\\Workspace\\QE_Platform_lead_Repos",
    "C:\\Development\\Workspace\\OratsUtil",
    "C:\\Development\\Workspace\\ChakraOptionsWatch",
    "banking and brokerage applications",
    "password managers",
    "private browser sessions"
  ],
  "actions": {
    "ping": "A0",
    "capability_inventory": "A0",
    "personal_artifact": "A1",
    "portfolio_inventory": "A0",
    "workspace_inventory": "A0",
    "cursor_call": "A1",
    "repo_preflight": "A0",
    "create_scoped_repair_workspace": "A1",
    "review_scoped_repair_patch": "A0",
    "apply_scoped_repair_patch": "A1",
    "cleanup_scoped_repair_workspace": "A1",
    "git_fetch": "A0",
    "git_pull": "A1",
    "git_create_feature_branch": "A1",
    "git_commit_scoped_changes": "A1",
    "git_push_feature_branch": "A2",
    "git_verify_remote_state": "A0",
    "git_create_pull_request": "A2",
    "git_update_pull_request": "A2",
    "git_review_pull_request": "A1",
    "git_merge_approved_pull_request": "A2"
  },
  "cursor_call": {
    "interface": "agent --print --output-format json --workspace <approved_repo>",
    "ide_launcher_is_not_this": "cursor.cmd",
    "routine_approval": "A1",
    "sensitive_or_consequential": "blocked pending A2/A3 owner gate"
  },
  "notes": [
    "A1 on personal roots is standing authorization. New personal folders do not need an allowlist entry.",
    "A2/A3 remain owner-gated unless the repository authorization registry records standing authorization for that exact operation.",
    "cua-driver MCP is not registered into Cursor, Claude, or Codex concurrently.",
    "UWP apps share ApplicationFrameHost; the worker does not grant that executable."
  ]
}
