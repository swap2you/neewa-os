    "%USERPROFILE%\\.aws",
    "%USERPROFILE%\\.gnupg",
    "C:\\Users",
    "employer repositories and documents",
    "banking and brokerage applications",
    "password managers",
    "private browser sessions"
  ],
  "actions": {
    "ping": "A0",
    "capability_inventory": "A0",
    "personal_artifact": "A1",
    "portfolio_inventory": "A1"
