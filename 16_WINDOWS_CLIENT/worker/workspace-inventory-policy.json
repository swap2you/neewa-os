{
  "schema_version": 1,
  "mode": "read_only_metadata",
  "authorization_mode": "personal_roots_except_denied",
  "workspace_root": "C:\\Development\\Workspace",
  "report_dir": "%USERPROFILE%\\NEEWA-Personal\\inventory",
  "personal_projects": [
    "NEEWA-OS",
    "aarohan-careeros",
    "ChakraOps",
    "ChakraOps-dev",
    "DevotionalRepo",
    "KidsProjects",
    "manan",
    "SocialMediaManager",
    "Zume"
  ],
  "denied_name_equals": [
    "api-fintech-automation-platform",
    "perf-fintech-testing-platform",
    "ui-fintech-automation-platform",
    "QE_Platform_lead_Repos",
    "OratsUtil",
    "ChakraOptionsWatch"
